# Backend used by the local Vite proxy. Public configuration only, no secrets.
PSN_API_TARGET=http://test.psn.n7s.co
# Production API origin and workspace suffix. This value is public in the bundle.
VITE_ADMIN_API_BASE=http://test.psn.n7s.co
VITE_OIDC_ISSUER_URL=https://keycloak-cust-01-faas-std.apps.clu02.paas-psn.priv/realms/openserverless-psn
VITE_OIDC_CLIENT_ID=openserverless-admin-api

# OPS CLI login profile (read from .env by ops ide login, not only .env.local).
OPS_APIHOST=http://test.psn.n7s.co
SSO_ENABLED=true
SSO_CLIENT_MODE=confidential
OPS_SSO_LOGIN_FLOW=device
